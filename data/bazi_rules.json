  "shishen_desc": {
    "比肩": "同我者阳见阳、阴见阴。代表自信自立、同伴合伙、竞争争先、意志坚韧。",
    "劫财": "同我者阳见阴、阴见阳。代表外向热烈、魄力决断、敢于冒险、交际广泛。",
    "食神": "我生者阳见阳、阴见阴。代表才华福禄、宽仁温和、审美鉴赏、悠闲从容。",
    "伤官": "我生者阳见阴、阴见阳。代表才华灵气、独创突破、傲骨不群、求新求变。",
    "偏财": "我克者阳见阳、阴见阴。代表开阔财源、善于运筹、豪爽慷慨、商业机敏。",
    "正财": "我克者阳见阴、阴见阳。代表勤俭持家、踏实稳健、按部就班、诚信本分。",
    "七杀": "克我者阳见阳、阴见阴。又称偏官。代表威严决断、抗压自律、开拓进取、领袖气度。",
    "正官": "克我者阳见阴、阴见阳。代表端庄守礼、名望责任、组织管理、公正光明。",
    "偏印": "生我者阳见阳、阴见阴。又称枭神。代表直觉洞察、玄学独思、冷峻深邃、偏门专精。",
    "正印": "生我者阳见阴、阴见阳。代表慈祥仁厚、文化学识、贵人庇护、声誉安定。"
  },
  "shensha_rules": {
    "天乙贵人": { "desc": "八字第一大吉星，逢凶化吉，一生遇难呈祥，多得师长与贵人扶持提携。" },
    "太极贵人": { "desc": "主聪明好学，有钻研精神，与玄学、哲学、文史艺术具宿世深厚缘分。" },
    "文昌贵人": { "desc": "主聪明文秀，才思敏捷，逢考有助，擅长文墨创作与学术专研。" },
    "禄神": { "desc": "身享财禄，衣食无忧，行事笃实，主自身开拓能力强与经济自足。" },
    "羊刃": { "desc": "气势极旺之刚烈星，主果断刚毅、魄力过人，利于武职、技术与大刀阔斧之事。" },
    "驿马": { "desc": "主志在四方、常有远行或变动、机动性强，擅长跨境、出差与拓荒业务。" },
    "桃花": { "desc": "又称咸池，主人缘魅力出众、神采俊秀、异性缘佳、擅于社交展现。" },
    "华盖": { "desc": "艺术与哲思之星，主气度高雅、清心寡欲，利于学术、玄学、艺术成就。" },
    "将星": { "desc": "领导力与统御之象，主临危不乱、具威信与组织号召力，适合领头创业。" },
    "天医": { "desc": "利于身心修养与调护，易通医道养生、心理治愈，常能为人解忧疗伤。" }
  }
